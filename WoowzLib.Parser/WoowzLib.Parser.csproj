<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Library</OutputType>
        <Nullable>enable</Nullable>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <IncludeDocumentationFile>true</IncludeDocumentationFile>

        <PackageId>Woowz11.WoowzLib.Parser</PackageId>
        <Version>0.0.1.6</Version>
        <Authors>Woowz11</Authors>
        <Description>WoowzLib File Parser</Description>
        <PackageLicenseExpression>CC-BY-SA-4.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Woowz11/WoowzLib/tree/main/WoowzLib.Parser</RepositoryUrl>
        <PackageTags>Woowz;Library;Easy;Game;Parser;Image;BMP;PNG;JPEG;GIF;TIFF;File;Byte;Russian</PackageTags>
        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WoowzLib.Core\WoowzLib.Core.csproj" />
        <!--<PackageReference Include="Woowz11.WoowzLib" Version="0.0.3" />-->

        <None Include="Icon.png" Pack="true" PackagePath="/" />
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>