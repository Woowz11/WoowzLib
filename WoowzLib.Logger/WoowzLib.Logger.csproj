<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Library</OutputType>
        <Nullable>enable</Nullable>

        <PackageId>Woowz11.WoowzLib.Logger</PackageId>
        <Version>0.0.0</Version>
        <Authors>Woowz11</Authors>
        <Description>Default WoowzLib Logger</Description>
        <PackageLicenseExpression>CC-BY-SA-4.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/Woowz11/WoowzLib/tree/main/WoowzLib.Logger</RepositoryUrl>
        <PackageTags>Woowz;Library;Logger</PackageTags>
        <PackageIcon>Icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <!--<ProjectReference Include="..\WoowzLib.Core\WoowzLib.Core.csproj" />-->
        <PackageReference Include="Woowz11.WoowzLib" Version="0.0.2" />
        
        <None Include="Icon.png" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>